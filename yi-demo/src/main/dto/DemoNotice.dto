/*
 * 只改了这个 dto、没有改其它 Kotlin 文件时，IDE 点运行不会重新生成。
 * 需要显式 Rebuild，或执行 gradle :yi-demo:kspKotlin。
 */

export com.star.demo.entity.DemoNotice
    -> package com.star.demo.dto

DemoNoticeView {
    #allScalars
    -deletedTime
}

input DemoNoticeCreateInput {
    title
    content
    pinned
}

input DemoNoticeUpdateInput {
    id?
    title
    content
    pinned
}

specification DemoNoticeSpecification {
    like/i(title)
    pinned
}
