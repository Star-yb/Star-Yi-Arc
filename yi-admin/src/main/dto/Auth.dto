/*
 * 只改了这个 dto、没有改其它 Kotlin 文件时，IDE 点运行不会重新生成。
 * 需要显式 Rebuild，或执行 gradle :yi-admin:kspKotlin。
 */

export com.star.identity.entity.Users
    -> package com.star.admin.dto

LoginView {
    id
    username
    token: String
    tokenTimeout: Long
}

input LoginInput {
    username
    password
}

VerifyView {
    tokenId: Any?
    token: String
    tokenTimeout: Long
    expired: Boolean?
    userStatus: Boolean?
    userId: String
}

input VerifyInput {
    token: String
}
