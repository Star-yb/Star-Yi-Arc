/*
 * 只改了这个 dto、没有改其它 Kotlin 文件时，IDE 点运行不会重新生成。
 * 需要显式 Rebuild，或执行 gradle :yi-admin:kspKotlin。
 */

export com.star.identity.entity.Roles
    -> package com.star.admin.dto

RolesView {
    #allScalars
    -deletedTime
}

input RoleCreateInputView {
    #allScalars(this)?
    roleName
    roleCode
}

input RoleUpdateInputView {
    #allScalars(this)?
    -status
    id?
}

dynamic input RolePermissionUpdateInputView {
    id
    id(permissions) as permissionIds
}

specification RoleSpecification {
    like/i(roleName)
    like/i(roleCode)
    status
}
